{
  "$id": "https://raw.githubusercontent.com/BX-Team/Riven/master/schema/v1/release.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release",
  "description": "`releases/<version>.json` — a self-contained release manifest.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "minecraft": {
      "type": "string"
    },
    "loader": {
      "$ref": "#/$defs/Loader"
    },
    "java": {
      "$ref": "#/$defs/Java"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Group"
      },
      "default": []
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReleaseFile"
      },
      "default": []
    },
    "icon": {
      "description": "The pack's picture; launchers show it, nothing installs it.",
      "anyOf": [
        {
          "$ref": "#/$defs/Asset"
        },
        {
          "type": "null"
        }
      ]
    },
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    }
  },
  "required": [
    "format",
    "id",
    "name",
    "version",
    "minecraft",
    "loader",
    "java"
  ],
  "$defs": {
    "Loader": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/LoaderKind"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "version"
      ]
    },
    "LoaderKind": {
      "type": "string",
      "enum": [
        "fabric",
        "quilt",
        "forge",
        "neoforge"
      ]
    },
    "Java": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Memory"
            },
            {
              "type": "null"
            }
          ]
        },
        "jvm_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "major"
      ]
    },
    "Memory": {
      "type": "object",
      "properties": {
        "min": {
          "type": "string"
        },
        "recommended": {
          "type": "string"
        }
      },
      "required": [
        "min",
        "recommended"
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "ReleaseFile": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/PackPath"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hashes": {
          "$ref": "#/$defs/Hashes"
        },
        "urls": {
          "description": "Mirrors in order; relative ones resolve against the manifest URL.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserve": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "size",
        "hashes",
        "urls",
        "side"
      ]
    },
    "PackPath": {
      "description": "Relative POSIX path: no leading `/`, `\\`, `:`, empty, `.` or `..` components.",
      "type": "string",
      "minLength": 1
    },
    "Hashes": {
      "description": "Hashes a source provided; the strongest present one is verified.",
      "type": "object",
      "properties": {
        "sha512": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha1": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Side": {
      "type": "string",
      "enum": [
        "client",
        "server",
        "both"
      ]
    },
    "Asset": {
      "description": "A file a release references without installing it.",
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hashes": {
          "$ref": "#/$defs/Hashes"
        },
        "urls": {
          "description": "Mirrors in order; relative ones resolve against the manifest URL.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "size",
        "hashes",
        "urls"
      ]
    }
  }
}
