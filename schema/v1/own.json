{
  "$id": "https://raw.githubusercontent.com/BX-Team/Riven/master/schema/v1/own.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnContent",
  "description": "`.riven/own.json` — content the player added to an instance; pack updates leave it alone.",
  "type": "object",
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "default": []
    },
    "pack": {
      "description": "Pack files the player switched off or removed; pack updates keep them that way.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackChoice"
      }
    },
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    }
  },
  "required": [
    "format"
  ],
  "$defs": {
    "Entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "file": {
          "$ref": "#/$defs/EntryFile"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "update": {
          "$ref": "#/$defs/UpdatePolicy"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "disabled": {
          "description": "Kept in the project but left out of releases, exports and test runs.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "source",
        "file",
        "side",
        "update",
        "reason"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "mod",
        "resourcepack",
        "shaderpack",
        "datapack",
        "file"
      ]
    },
    "Source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "modrinth"
            },
            "project": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "project",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "github"
            },
            "repo": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "asset": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "repo",
            "tag",
            "asset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "local"
            },
            "path": {
              "$ref": "#/$defs/PackPath"
            }
          },
          "required": [
            "type",
            "path"
          ]
        }
      ]
    },
    "PackPath": {
      "description": "Relative POSIX path: no leading `/`, `\\`, `:`, empty, `.` or `..` components.",
      "type": "string",
      "minLength": 1
    },
    "EntryFile": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/PackPath"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hashes": {
          "$ref": "#/$defs/Hashes"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "size",
        "hashes"
      ]
    },
    "Hashes": {
      "description": "Hashes a source provided; the strongest present one is verified.",
      "type": "object",
      "properties": {
        "sha512": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha1": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Side": {
      "type": "string",
      "enum": [
        "client",
        "server",
        "both"
      ]
    },
    "UpdatePolicy": {
      "type": "string",
      "enum": [
        "follow",
        "pinned"
      ]
    },
    "Reason": {
      "type": "string",
      "enum": [
        "explicit",
        "dependency"
      ]
    },
    "PackChoice": {
      "description": "The player's say over one file of an instance's pack.",
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/PackPath"
        },
        "project": {
          "description": "The Modrinth project, which finds the file again when an update renames it.",
          "type": [
            "string",
            "null"
          ]
        },
        "removed": {
          "description": "Removed rather than switched off.",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ]
    }
  }
}
