{
  "$id": "https://raw.githubusercontent.com/BX-Team/Riven/master/schema/v1/state.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State",
  "description": "`.riven/state.json` — what riven installed into an instance.",
  "type": "object",
  "properties": {
    "source": {
      "description": "Channel pointer URL.",
      "type": "string"
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "side": {
      "$ref": "#/$defs/InstallSide"
    },
    "version": {
      "type": "string"
    },
    "etag": {
      "type": [
        "string",
        "null"
      ]
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "default": {}
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/StateFile"
      },
      "default": {}
    },
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    }
  },
  "required": [
    "format",
    "source",
    "side",
    "version"
  ],
  "$defs": {
    "InstallSide": {
      "description": "The side an instance is installed as.",
      "type": "string",
      "enum": [
        "client",
        "server"
      ]
    },
    "StateFile": {
      "type": "object",
      "properties": {
        "sha512": {
          "type": "string"
        },
        "preserve": {
          "type": "boolean"
        }
      },
      "required": [
        "sha512"
      ]
    }
  }
}
