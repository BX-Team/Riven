{
  "$id": "https://raw.githubusercontent.com/BX-Team/Riven/master/schema/v1/channel.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Channel",
  "description": "`channels/<name>.json` — the tiny pointer polled on every launch.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "manifest": {
      "description": "Manifest URL, relative to the pointer.",
      "type": "string"
    },
    "sha512": {
      "type": "string"
    },
    "key": {
      "description": "The signer's public key, pinned on first install when the link carries none.",
      "type": [
        "string",
        "null"
      ]
    },
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    }
  },
  "required": [
    "format",
    "version",
    "manifest",
    "sha512"
  ]
}
